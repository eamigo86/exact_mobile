{
  "$schema": ".exact/checkout/scripts/app.schema.json",
  "name": "Exact Todo",
  "short_name": "Exact Todo",
  "id": "com.example.exacttodo",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f6f3ee",
  "color_scheme_dark": {
    "background_color": "#151210"
  },
  "icons": [
    {
      "src": "assets/brand/icon-1024.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "assets/brand/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "app": {
    "id": "com.example.exacttodo",
    "name": "Exact Todo"
  },
  "host": {
    "web": {},
    "ios": {
      "minimumOS": "17.0",
      "deviceFamily": [
        "iphone",
        "ipad"
      ]
    },
    "android": {},
    "macos": {
      "minimumOS": "14.0",
      "window": {
        "width": 900,
        "height": 700
      }
    }
  },
  "deploy": {
    "store": {
      "web": "0",
      "ios": "0",
      "macos": "0",
      "linux": "0"
    }
  }
}

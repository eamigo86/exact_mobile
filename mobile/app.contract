// Exact Todo: four tabs (Home, Tasks, Categories, Settings). Tasks and categories are
// app.ts's (app:/data/todo.json); the display name is a persisted setting. "Today" and
// "Overdue" read the date from the clock the root keeps (`dates-and-days`), so the day
// logic lives here in plain functions that tests drive with `epoch`.
use EmptyState, RingProgress from "exact:content"
use getCurrentPosition, GeolocationPosition from "@exact/geolocation"

routes nav
  tab home "/"
  tab tasks "/tasks"
    addTask "/new-task"
    editTask "/task/:id"
  tab categories "/categories"
    addCategory "/new-category"
  tab settings "/settings"

shape Task
  id: string
  title: string
  notes: string
  categoryId: string
  due: string
  time: string
  done: bool

shape Category
  id: string
  name: string
  color: string

shape CatRow
  id: string
  name: string
  color: string
  count: number

shape Reply
  ok: bool
  error: string

shape Time
  epochAtZero: number
  utcOffset: number

fn isOverdue(t: Task, today: string): bool = not t.done and t.due != "" and t.due < today
fn isToday(t: Task, today: string): bool = t.due == today
fn passes(t: Task, status: string, cat: string, today: string): bool =
  (cat == "" or t.categoryId == cat) and (status == "all" or (status == "active" and not t.done) or (status == "done" and t.done) or (status == "today" and isToday(t, today)) or (status == "overdue" and isOverdue(t, today)))
fn categoryName(cats: Category[], id: string): string = match first(cats.filter(c => c.id == id)) { case some(c) => c.name, case none => "" }
fn dueText(t: Task): string = t.due == "" ? "" : t.time == "" ? formatDate(t.due, 0, "medium") : `${formatDate(t.due, 0, "medium")} ${t.time}`
fn metaText(t: Task, cats: Category[]): string = [categoryName(cats, t.categoryId), dueText(t)].filter(s => s != "").join(" · ")
fn countText(n: number): string = `${n} ${n == 1 ? "task" : "tasks"}`
fn dueKey(t: Task): string = t.due == "" ? "9999-99-99" : t.due
fn catToken(cats: Category[], id: string): string = match first(cats.filter(c => c.id == id)) { case some(c) => `cat.${c.color}`, case none => "text.secondary" }
fn hourOf(ms: number, offset: number): number = floor((((ms / 60000 + offset) % 1440) + 1440) % 1440 / 60)
fn salutation(hour: number): string = hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening"
fn chipLabel(k: string): string = k == "all" ? "All" : k == "active" ? "Active" : k == "done" ? "Done" : k == "today" ? "Today" : "Overdue"
fn colorLabel(k: string): string = k == "blue" ? "Blue" : k == "violet" ? "Violet" : k == "pink" ? "Pink" : k == "orange" ? "Orange" : k == "green" ? "Green" : "Teal"
fn initial(name: string): string = name.trim() == "" ? "" : name.trim().slice(0, 1).toUpperCase()
fn tabTitle(name: string): string = name == "home" ? "Home" : name == "tasks" ? "Tasks" : name == "categories" ? "Categories" : "Settings"

// Splash and onboarding motion. `both` holds the first frame through a delay and the last after.
keyframes logoPop
  from opacity=0 scale=0.6
  60% opacity=1 scale=1.06
  to opacity=1 scale=1
// Width and per-axis scale do not animate, so the paper lines are round-capped strokes that
// draw by dash offset, like the check. The dash gap starts past the cap, hiding the dot it leaves.
keyframes growLong
  from stroke-dashoffset=90
  to stroke-dashoffset=0
keyframes growShort
  from stroke-dashoffset=60
  to stroke-dashoffset=0
keyframes drawCheck
  from stroke-dashoffset=250
  to stroke-dashoffset=0
keyframes nameIn
  from opacity=0 translate="0px 10px"
  to opacity=1 translate="0px 0px"
keyframes stepIn
  from opacity=0 translate="28px 0px"
  to opacity=1 translate="0px 0px"
keyframes fadeOut
  to opacity=0

shape Media
  prefersReducedMotion: bool

fn stepTitle(i: number): string = i == 0 ? "Capture it all" : i == 1 ? "Sort by category" : i == 2 ? "Never miss a time" : "Watch progress grow"
fn stepLine(i: number): string = i == 0 ? "Add a task in seconds, before it slips away." : i == 1 ? "Color-coded lists keep work, home and errands apart." : i == 2 ? "Give tasks a due date and a time." : "Your dashboard shows what is done today."
fn schemeLabel(k: string): string = k == "system" ? "System" : k == "light" ? "Light" : "Dark"

component App
  state name = "" persist
  state filter = "all"
  state catFilter = ""
  state now = 0
  state catDraft = ""
  state catColor = "blue"
  state catRefusal = ""
  state onboarded = false persist
  state scheme = "system" persist
  state step = 0
  state replay = false
  state splash = true
  state leaving = false
  resource media = exactViewport() as shape Media
  resource time = exactTime() as shape Time
  resource tasks = loadTasks() as shape Task[] else empty()
  resource categories = loadCategories() as shape Category[] else empty()
  mutation saved as shape Reply queue refreshes tasks
  mutation toggled as shape Reply queue refreshes tasks
  mutation removed as shape Reply queue refreshes tasks
  mutation catAdded as shape Reply queue refreshes categories then afterCat
  mutation located as shape GeolocationPosition
  derive today = formatDate(time.epochAtZero + now, time.utcOffset, "iso")
  derive shown = tasks.filter(t => passes(t, filter, catFilter, today))
  derive todayTasks = tasks.filter(t => isToday(t, today))
  derive todayDone = todayTasks.filter(t => t.done).length
  derive overdueCount = tasks.filter(t => isOverdue(t, today)).length
  derive upNext = sortBy(sortBy(tasks.filter(t => not t.done), t => t.time), t => dueKey(t)).slice(0, 5)
  derive catRows = categories.map(c => CatRow(id=c.id, name=c.name, color=c.color, count=tasks.filter(x => x.categoryId == c.id).length))
  derive hour = hourOf(time.epochAtZero + now, time.utcOffset)
  derive greeting = name.trim() == "" ? "Hello" : `${salutation(hour)}, ${name.trim()}`
  derive todayFraction = todayTasks.length == 0 ? 0 : todayDone / todayTasks.length
  derive still = media.prefersReducedMotion
  derive onboarding = (not onboarded or replay) and (leaving or not splash)
  derive covered = splash or onboarding
  derive catError = match catAdded { case some(r) => r.error, case none => "" }
  derive locationCode = match failure(located) { case some(f) => f.code, case none => "" }
  derive locationMessage = locationCode == "" ? "" : locationCode == "PERMISSION_DENIED" ? "Location permission denied. Allow it in the system settings." : locationCode == "POSITION_UNAVAILABLE" ? "Location services are off. Turn them on and try again." : `Could not get the location: ${locationCode}`
  derive here = locationCode == "" ? located : none
  derive latText = match here { case some(p) => `Latitude ${p.coords.latitude.toFixed(5)}`, case none => "" }
  derive lonText = match here { case some(p) => `Longitude ${p.coords.longitude.toFixed(5)}`, case none => "" }
  derive accText = match here { case some(p) => `Accuracy ${round(p.coords.accuracy)} m`, case none => "" }
  task tick mount
    every(60000, tickNow)
  // The splash holds, fades (250 ms) and goes; reduced motion holds less.
  task hold when splash and not leaving and not still
    after(1250, leaveSplash)
  task holdStill when splash and not leaving and still
    after(700, leaveSplash)
  task endFade when leaving
    after(250, endSplash)
  // setScheme is not kept by the host: the persisted choice is applied again at every launch.
  task schemeAtLaunch mount
    after(1, restoreScheme)
  action tickNow
    now = performanceNow()
  action leaveSplash
    leaving = true
  action endSplash
    splash = false
  action nextStep
    if step < 3
      step = step + 1
    else
      onboarded = true
      replay = false
      step = 0
  action swipeNext
    if step < 3
      step = step + 1
  action prevStep
    if step > 0
      step = step - 1
  action goStep(i: number)
    step = i
  action skipOnboarding
    onboarded = true
    replay = false
    step = 0
  action showOnboarding
    step = 0
    replay = true
  action setAppearance(v: string)
    scheme = v
    setScheme(v)
  action restoreScheme
    setScheme(scheme)
  action pick(tab: string)
    blur()
    nav = select(nav, tab)
  action follow(url: string)
    nav = go(nav, url)
  action back
    nav = back(nav)
  action setFilter(v: string)
    filter = v
  action setCatFilter(v: string)
    catFilter = v
  action setName(v: string)
    name = v
  action showLocation
    send located = getCurrentPosition(enableHighAccuracy=true, maximumAge=0)
  action openAddTask
    nav = push(nav, "/new-task")
  action commitTask(id: string, title: string, notes: string, categoryId: string, due: string, time: string)
    send saved = saveTask(id, title.trim(), notes.trim(), categoryId, due, time)
    nav = back(nav)
  action toggle(id: string, done: bool)
    send toggled = toggleTask(id, done)
  action remove(id: string)
    send removed = removeTask(id)
  action openAddCategory
    catDraft = ""
    catColor = "blue"
    catRefusal = ""
    nav = push(nav, "/new-category")
  action editCat(v: string)
    catDraft = v
  action pickColor(v: string)
    catColor = v
  action saveCat
    if catDraft.trim() != "" and not pending(catAdded)
      send catAdded = addCategory(catDraft.trim(), catColor)
  // The sheet closes only on an ok reply; a refusal stays, saying why.
  action afterCat
    catRefusal = catError
    if catError == "" and top(nav).name == "addCategory"
      nav = back(nav)

  view
    main navigationKey=`${top(nav).id}` accent-color="brand.accent"
      navigationBack="back"
      navigate=follow
      testId="app"
      width="100%"
      height="100%"
      display="flex"
      flex-direction="column"
      position="relative"
      column flex=1 min-height=0 position="relative" inert=covered
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              if e.name == "addTask"
                TaskForm(
                  route=e.id,
                  task=Task(id="", title="", notes="", categoryId="", due="", time="", done=false),
                  categories=categories,
                  save=commitTask,
                  cancel=back,
                  heading="New Task"
                )
              else if e.name == "editTask"
                for x in tasks.filter(k => k.id == e.params.id) key=x.id
                  TaskForm(
                    route=e.id,
                    task=x,
                    categories=categories,
                    save=commitTask,
                    cancel=back,
                    heading="Edit Task"
                  )
              else if e.name == "addCategory"
                column navigationKey=`${e.id}`
                  navigationPresentation="modal"
                  navigationScroll="cat-form"
                  position="absolute"
                  inset=0
                  display="flex"
                  flex-direction="column"
                  header display="flex"
                    align-items="center"
                    justify-content="space-between"
                    padding="8px 16px"
                    button id="back" press=back aria-label="Cancel" testId="cat-cancel"
                      image "symbol:close"
                    text "New Category" role="heading"
                    button press=saveCat
                      buttonStyle="bordered-prominent"
                      aria-label="Save"
                      testId="cat-save"
                      disabled=(catDraft.trim() == "" or pending(catAdded))
                      image "symbol:checkmark"
                  list id="cat-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    section
                      row
                        column flex=1 min-width=0 gap=4
                          input value=catDraft
                            input=editCat
                            placeholder="Name"
                            aria-label="Name"
                            autofocus=true
                            submit=saveCat
                            aria-invalid=(catRefusal != "")
                            testId="cat-name"
                          if catRefusal != ""
                            text catRefusal font="-exact-footnote"
                              color="-exact-system-red"
                              testId="cat-error"
                      footer
                        text (catDraft.trim() == "" ? "Enter a name to save." : "") testId="cat-hint"
                    section
                      header
                        text "Color"
                      row
                        row gap=4 flex-wrap="wrap" flex=1 min-width=0 role="radiogroup" aria-label="Color"
                          for k in ["blue", "violet", "pink", "orange", "green", "teal"] key=k
                            column press=pickColor(k)
                              role="radio"
                              aria-checked=(catColor == k)
                              aria-label=colorLabel(k)
                              testId=`swatch-${k}`
                              width="2.75rem"
                              height="2.75rem"
                              align-items="center"
                              justify-content="center"
                              column width="2.25rem" height="2.25rem" border-radius="50%" align-items="center" justify-content="center"
                                background-color=`cat.${k}`
                                border=(catColor == k ? "3px solid text.primary" : "3px solid transparent")
                                if catColor == k
                                  image "symbol:checkmark" color="ink.on-color" aria-hidden=true
              else
                column navigationKey=`${e.id}`
                  navigationScroll=`content-${e.id}`
                  position="absolute"
                  inset=0
                  display="flex"
                  flex-direction="column"
                  background-color="surface.page"
                  header display="flex" align-items="center" gap=8 padding="8px 16px"
                    text tabTitle(e.name) role="heading" aria-level=1 flex=1 testId=`${e.name}-title`
                    if e.name == "categories"
                      button press=openAddCategory aria-label="Add Category" testId="add-category"
                        image "symbol:add"
                  if e.name == "home"
                    scroll id=`content-${e.id}` flex=1 min-height=0
                      column gap=20 padding-bottom=24
                        column padding="20px 16px" margin="8px 16px 0px" gap=16 border-radius=32
                          background-color="hero.base"
                          background-image="radial-gradient(circle at 15% 10%, hero.glow1, transparent 60%), radial-gradient(circle at 90% 20%, hero.glow2, transparent 55%), radial-gradient(circle at 60% 100%, hero.glow3, transparent 60%)"
                          testId="hero"
                          text greeting font="-exact-title2" font-weight=600 color="ink.on-hero" testId="greeting"
                          row flex-wrap="wrap" background-color="surface.card" border-radius=24 padding=16 gap=16 align-items="center"
                            column width=120 flex-shrink=0
                              RingProgress(label="Done", value=`${round(todayFraction * 100)}%`, fraction=todayFraction, tint=none)
                            column flex="1 1 8rem" min-width=0 gap=4
                              text `${todayDone} of ${todayTasks.length} done today` font="-exact-title3"
                                color="text.primary" testId="progress-text"
                              text (overdueCount > 0 ? `${overdueCount} overdue` : "Nothing overdue") font="-exact-footnote"
                                color=(overdueCount > 0 ? "danger" : "text.secondary")
                          row glassGroup=12 gap=12 flex-wrap="wrap"
                            column flex="1 1 3.5rem" min-width=0 backgroundMaterial="glass" border-radius=20 padding=14 gap=4
                              -exact-glass-tint="glass.tint"
                              image "symbol:list" color="ink.on-hero" aria-hidden=true width="1.5rem" height="1.5rem"
                              text `${tasks.length}` font-size="1.75rem" font-weight=700 font-variant-numeric="tabular-nums"
                                color="ink.on-hero" testId="count-all"
                              text "All" font="-exact-footnote" color="ink.on-hero"
                            column flex="1 1 3.5rem" min-width=0 backgroundMaterial="glass" border-radius=20 padding=14 gap=4
                              -exact-glass-tint="glass.tint"
                              image "symbol:calendar" color="ink.on-hero" aria-hidden=true width="1.5rem" height="1.5rem"
                              text `${todayTasks.length}` font-size="1.75rem" font-weight=700 font-variant-numeric="tabular-nums"
                                color="ink.on-hero" testId="count-today"
                              text "Today" font="-exact-footnote" color="ink.on-hero"
                            column flex="1 1 3.5rem" min-width=0 backgroundMaterial="glass" border-radius=20 padding=14 gap=4
                              -exact-glass-tint="glass.tint"
                              image "symbol:alert" color=(overdueCount > 0 ? "danger" : "ink.on-hero") aria-hidden=true width="1.5rem" height="1.5rem"
                              text `${overdueCount}` font-size="1.75rem" font-weight=700 font-variant-numeric="tabular-nums"
                                color=(overdueCount > 0 ? "danger" : "ink.on-hero") testId="count-overdue"
                              text "Overdue" font="-exact-footnote" color="ink.on-hero"
                        column margin="0px 16px" padding=16 gap=4 border-radius=24 background-color="surface.card" testId="upnext"
                          text "Up next" role="heading" aria-level=2 color="text.primary" font="-exact-title3"
                          for x in upNext key=x.id
                            row gap=12 align-items="center" min-height=44 testId=`upnext-${x.id}`
                              view width=10 height=10 border-radius=5 background-color=catToken(categories, x.categoryId)
                              column flex=1 min-width=0
                                text x.title color="text.primary"
                                if dueText(x) != ""
                                  text dueText(x) font="-exact-footnote" color=(isOverdue(x, today) ? "-exact-system-red" : "text.secondary")
                          if upNext.length == 0
                            text "Nothing to do." color="text.secondary"
                  else if e.name == "tasks"
                    if tasks.length == 0 and not pending(tasks)
                      EmptyState(symbol="symbol:checkmark", title="No Tasks", message="Tasks you add appear here.")
                    else
                      list id=`content-${e.id}` background-color="surface.page"
                        appearance="auto"
                        listStyle="inset-grouped"
                        flex=1
                        min-height=0
                        section
                          row
                            row overflow-x="auto" gap=8 padding=8 border-radius=16 flex=1 min-width=0 testId="chips"
                              background-image="linear-gradient(150deg, hero.glow1, hero.glow2)"
                              for k in ["all", "active", "done", "today", "overdue"] key=k
                                button press=setFilter(k)
                                  buttonStyle=(filter == k ? "prominent-glass" : "glass")
                                  aria-pressed=(filter == k)
                                  testId=`chip-${k}`
                                  flex-shrink=0
                                  text chipLabel(k) white-space="nowrap"
                          row
                            text "Category"
                            select value=catFilter
                              change=setCatFilter
                              aria-label="Category"
                              testId="filter-category"
                              option "All categories" value=""
                              for c in categories key=c.id
                                option c.name value=c.id
                        if shown.length == 0
                          section
                            row
                              text "No tasks match." color="-exact-secondary-label"
                                testId="no-match"
                        else
                          section
                            for x in shown key=x.id
                              row delete=remove(x.id) testId=`task-${x.id}`
                                input type="checkbox"
                                  checked=x.done
                                  change=toggle(x.id)
                                  aria-label=`Done: ${x.title}`
                                  testId=`done-${x.id}`
                                link href=path("editTask", x.id)
                                  display="flex"
                                  align-items="center"
                                  gap=8
                                  flex=1
                                  min-width=0
                                  min-height=44
                                  testId=`open-${x.id}`
                                  view width=10 height=10 border-radius=5 background-color=catToken(categories, x.categoryId)
                                  column flex=1 min-width=0
                                    text x.title testId=`title-${x.id}`
                                    if metaText(x, categories) != ""
                                      text metaText(x, categories) font="-exact-footnote"
                                        color=(isOverdue(x, today) ? "-exact-system-red" : "-exact-secondary-label")
                                        testId=`meta-${x.id}`
                                  image "symbol:forward-chevron"
                    row justify-content="flex-end" padding="8px 16px 12px"
                      button press=openAddTask buttonStyle="prominent-glass" aria-label="Add Task" testId="add-task"
                        image "symbol:add"
                  else if e.name == "categories"
                    scroll id=`content-${e.id}` flex=1 min-height=0
                      row flex-wrap="wrap" gap=12 padding=16
                        for c in catRows key=c.id
                          column flex="1 1 8rem" min-width=0 gap=12 padding=16 border-radius=24
                            background-color=`cat.${c.color}.tint`
                            testId=`card-${c.id}`
                            column width="2.5rem" height="2.5rem" border-radius="1.25rem" align-items="center" justify-content="center"
                              background-color=`cat.${c.color}`
                              image "symbol:list" color="ink.on-color" aria-hidden=true width="1.25rem" height="1.25rem"
                            column gap=2
                              text c.name font="-exact-headline" color="text.primary" testId=`category-${c.id}`
                              text countText(c.count) font="-exact-footnote" color="text.secondary"
                                testId=`count-${c.id}`
                  else
                    list id=`content-${e.id}`
                      appearance="auto"
                      listStyle="inset-grouped"
                      flex=1
                      min-height=0
                      section
                        row gap=16 align-items="center"
                          column width="4rem" height="4rem" border-radius="2rem" align-items="center" justify-content="center"
                            background-image="linear-gradient(150deg, hero.glow1, hero.glow2)"
                            testId="avatar"
                            if initial(name) == ""
                              image "symbol:person" color="ink.on-hero" aria-hidden=true
                            else
                              text initial(name) font="-exact-title1" color="ink.on-hero"
                          column flex=1 min-width=0
                            text (name.trim() == "" ? "Your name" : name.trim()) font="-exact-headline"
                        row
                          input value=name
                            input=setName
                            placeholder="Display name"
                            aria-label="Display name"
                            autocomplete="name"
                            autocapitalize="words"
                            testId="settings-name"
                            flex=1
                            min-width=0
                        footer
                          text "Shown in the greeting on Home."
                      section
                        header
                          text "Location"
                        row
                          button press=showLocation disabled=pending(located) testId="location-button"
                            text "Show my location"
                        if latText != ""
                          column gap=4
                            text latText font="-exact-body" color="text.primary" testId="location-latitude"
                            text lonText font="-exact-body" color="text.primary" testId="location-longitude"
                            text accText font="-exact-footnote" color="text.secondary" testId="location-accuracy"
                        if locationMessage != ""
                          text locationMessage font="-exact-footnote" color="danger" testId="location-message"
                      section
                        header
                          text "Appearance"
                        row role="radiogroup" aria-label="Appearance" gap=8
                          for k in ["system", "light", "dark"] key=k
                            button role="radio" aria-checked=(scheme == k) press=setAppearance(k) testId=`scheme-${k}` flex=1
                              text schemeLabel(k)
                        footer
                          text "System follows the device setting."
                      section
                        header
                          text "Help"
                        row
                          button press=showOnboarding testId="show-onboarding"
                            text "Show onboarding again"
      // Android draws the root tablist as a native bar that the overlays do not cover, so it hides while they show.
      row role="tablist" testId="tabs" inert=covered display=(covered ? "none" : "flex")
        for t in nav.tabs key=t.name
          button role="tab"
            aria-controls=`panel-${t.name}`
            aria-selected=(nav.tab == t.name)
            press=pick(t.name)
            testId=`tab-${t.name}`
            flex=1
            image (t.name == "home" ? "symbol:home" : t.name == "tasks" ? "symbol:checkmark" : t.name == "categories" ? "symbol:list" : "symbol:settings")
            text tabTitle(t.name)
      if onboarding
        Onboarding(step=step, still=still, next=nextStep, back=prevStep, skip=skipOnboarding, go=goStep, swipeNext=swipeNext)
      if splash
        Splash(still=still, leaving=leaving)

// The add and edit sheet: its drafts start from the task its route shows.
component TaskForm
  props
    route: number
    task: Task
    categories: Category[]
    save: action
    cancel: action
    heading: string
  state title = task.title
  state notes = task.notes
  state categoryId = task.categoryId
  state due = task.due
  state time = task.time
  action setTitle(v: string)
    title = v
  action setNotes(v: string)
    notes = v
  action setCategory(v: string)
    categoryId = v
  action setDue(v: string)
    due = v
  action setTime(v: string)
    time = v
  action clearDue
    due = ""
    time = ""
  view
    column navigationKey=`${route}`
      navigationPresentation="modal"
      navigationScroll="task-form"
      position="absolute"
      inset=0
      display="flex"
      flex-direction="column"
      header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
        button id="back" press=cancel aria-label="Cancel" testId="form-cancel"
          image "symbol:close"
        text heading role="heading"
        button press=save(task.id, title, notes, categoryId, due, time)
          buttonStyle="bordered-prominent"
          aria-label="Save"
          disabled=(title.trim() == "")
          testId="form-save"
          image "symbol:checkmark"
      list id="task-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
        section
          row
            input value=title
              input=setTitle
              placeholder="Title"
              aria-label="Title"
              autofocus=true
              testId="form-title"
              flex=1
              min-width=0
          footer
            text (title.trim() == "" ? "Enter a title to save." : "") testId="form-hint"
        section
          header
            text "Notes"
          row padding-top=8 padding-bottom=8
            textarea value=notes
              input=setNotes
              placeholder="Optional"
              aria-label="Notes"
              rows=3
              testId="form-notes"
              flex=1
              min-width=0
        section
          row
            text "Category"
            select value=categoryId change=setCategory aria-label="Category" testId="form-category"
              option "None" value=""
              for c in categories key=c.id
                option c.name value=c.id
          row
            text "Due date"
            input type="date" value=due change=setDue aria-label="Due date" testId="form-due"
          row
            text "Due time"
            input type="time" value=time change=setTime aria-label="Due time" testId="form-time"
          if due != ""
            button press=clearDue testId="form-clear-due"
              text "Remove Due Date"

// The in-app splash: assets/brand/logo.svg drawn in place, so its parts can move. The tile pops
// (0-450 ms), the paper lines grow (300-600 ms), the check draws by its dash offset (550-900 ms)
// and the name rises (700-1000 ms). `still` (reduced motion) keeps all of it in place.
component Splash
  props
    still: bool
    leaving: bool
  view
    column testId="splash" role="img" aria-label="Exact Todo"
      position="absolute"
      inset=0
      background-color="surface.page"
      align-items="center"
      justify-content="center"
      gap=20
      opacity=(leaving ? 0 : 1)
      transition=(still ? "opacity 150ms linear" : "opacity 250ms ease-in")
      column width=120 height=120 animation=(still ? "none" : "logoPop 450ms ease-out both")
        svg width=120 height=120 viewBox="0 0 512 512" aria-hidden=true
          defs
            linearGradient id="tile" x1=0 y1=0 x2=1 y2=1
              stop offset=0 stop-color="#f28c4e"
              stop offset=1 stop-color="#c2410c"
          rect width=512 height=512 rx=116 fill="url(#tile)"
          path d="M164 104h136l76 76v220a28 28 0 0 1-28 28H164a28 28 0 0 1-28-28V132a28 28 0 0 1 28-28z" fill="#fffaf5"
          path d="M300 104v52a24 24 0 0 0 24 24h52z" fill="#ffd2b8"
          line x1=182 y1=178 x2=258 y2=178 stroke="#f3d9c8" stroke-width=20 stroke-linecap="round" stroke-dasharray="76 200" stroke-dashoffset=0
            animation=(still ? "none" : "growLong 300ms ease-out 300ms both")
          line x1=182 y1=222 x2=226 y2=222 stroke="#f3d9c8" stroke-width=20 stroke-linecap="round" stroke-dasharray="44 200" stroke-dashoffset=0
            animation=(still ? "none" : "growShort 300ms ease-out 400ms both")
          path d="M190 318l46 46 92-108" fill="none" stroke="#c2410c" stroke-width=36 stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="210 400" stroke-dashoffset=0 animation=(still ? "none" : "drawCheck 350ms ease-out 550ms both")
      text "Exact Todo" font="-exact-title2" font-weight=700 color="text.primary"
        animation=(still ? "none" : "nameIn 300ms ease-out 700ms both")

// The four onboarding steps. A step is one screen: the illustration, a title and one line. The
// content is keyed by the step, so each step mounts afresh and plays its entrance.
component Onboarding
  props
    step: number
    still: bool
    next: action
    back: action
    skip: action
    go: action
    swipeNext: action
  view
    column testId="onboarding" position="absolute" inset=0 display="flex" flex-direction="column"
      background-color="surface.page"
      -exact-exit-animation=(still ? "none" : "fadeOut 200ms ease-in both")
      // The overlay covers the whole screen, so its own bars keep clear of the status bar and home indicator.
      row padding="8px 16px" padding-top="calc(var(--exact-safe-area-inset-top) + 8px)" align-items="center" min-height=44
        column flex=1 align-items="flex-start"
          if step > 0
            button press=back buttonStyle="plain" testId="onb-back"
              text "Back"
        button press=skip buttonStyle="plain" testId="onb-skip"
          text "Skip"
      column flex=1 min-height=0 align-items="center" justify-content="center" padding="0px 24px"
        testId="onb-content"
        swipeleft=swipeNext
        swiperight=back
        touch-action="pan-y"
        for s in [step] key=s
          column align-items="center" gap=24 animation=(still ? "none" : "stepIn 300ms ease-out both")
            if s == 0
              CaptureArt()
            else if s == 1
              OrganizeArt()
            else if s == 2
              PlanArt()
            else
              ProgressArt()
            column gap=8 align-items="center"
              text stepTitle(s) role="heading" aria-level=1 font="-exact-title1" font-weight=700
                text-align="center" color="text.primary" testId="onb-title"
              text stepLine(s) font="-exact-body" text-align="center" color="text.secondary" testId="onb-body"
      row role="tablist" aria-label="Onboarding steps" justify-content="center" align-items="center"
        for i in [0, 1, 2, 3] key=i
          column role="tab" aria-selected=(i == step) aria-label=`Step ${i + 1} of 4` press=go(i) background-color="transparent"
            testId=`onb-dot-${i}`
            width=(i == step ? 38 : 24)
            height=24
            align-items="center"
            justify-content="center"
            -exact-layout-transition=(still ? "none" : "200ms ease")
            column height=8 border-radius=4 width=(i == step ? 22 : 8)
              background-color=(i == step ? "brand.accent" : "text.secondary")
              opacity=(i == step ? 1 : 0.35)
              -exact-layout-transition=(still ? "none" : "200ms ease")
              transition=(still ? "none" : "opacity 200ms ease")
      button press=next buttonStyle="filled" margin="16px 24px 24px 24px" margin-bottom="calc(var(--exact-safe-area-inset-bottom) + 16px)" testId="onb-next"
        text (step == 3 ? "Get started" : "Next")


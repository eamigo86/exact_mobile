test "default categories are seeded"
  clock +1600
  tap "onb-skip"
  clock settle
  clock data
  expect state categories.0 .name == "Home"
  expect state categories.1 .name == "Work"
  expect state categories.2 .name == "Personal"

test "seeded categories have distinct colours"
  clock +1600
  tap "onb-skip"
  clock settle
  clock data
  expect state categories.0 .color == "blue"
  expect state categories.1 .color == "violet"
  expect state categories.2 .color == "pink"

test "a category stores the colour picked in its sheet"
  clock +1600
  tap "onb-skip"
  clock settle
  tap "tab-categories"
  tap "add-category"
  clock settle
  tap "swatch-orange"
  expect state catColor == "orange"
  type "cat-name" "Errands"
  tap "cat-save"
  clock data
  clock settle
  expect state categories.3 .color == "orange"
  expect tree has "card-4"

test "a category added without picking gets the default colour"
  clock +1600
  tap "onb-skip"
  clock settle
  tap "tab-categories"
  tap "add-category"
  clock settle
  type "cat-name" "Errands"
  tap "cat-save"
  clock data
  clock settle
  expect state categories.3 .color == "blue"

test "a task is added, an empty title refused"
  clock +1600
  tap "onb-skip"
  clock settle
  tap "tab-tasks"
  tap "add-task"
  clock settle
  expect disabled "form-save"
  type "form-title" "Buy milk"
  type "form-notes" "Two litres"
  type "form-category" "2"
  expect enabled "form-save"
  tap "form-save"
  clock data
  clock settle
  expect text "title-1" == "Buy milk"
  expect text "meta-1" == "Work"
  expect state tasks.0 .notes == "Two litres"

test "a task is toggled done and deleted"
  clock +1600
  tap "onb-skip"
  clock settle
  tap "tab-tasks"
  tap "add-task"
  clock settle
  type "form-title" "Call Ann"
  tap "form-save"
  clock data
  clock settle
  tap "done-1"
  clock data
  expect state tasks.0 .done == true
  tap "task-1-delete"
  clock data
  expect state tasks == []
  expect tree missing "task-1"

test "a task is edited through its sheet"
  clock +1600
  tap "onb-skip"
  clock settle
  tap "tab-tasks"
  tap "add-task"
  clock settle
  type "form-title" "Call Ann"
  tap "form-save"
  clock data
  clock settle
  tap "open-1"
  clock settle
  expect text "form-title" == "Call Ann"
  type "form-title" "Call Anna"
  type "form-due" "2026-03-20"
  type "form-time" "09:30"
  tap "form-save"
  clock data
  clock settle
  expect text "title-1" == "Call Anna"
  expect text "meta-1" == "Mar 20, 2026 09:30"

test "filters narrow the list by status and category"
  epoch "2026-03-15T12:00:00Z"
  time-zone "UTC"
  clock +1600
  tap "onb-skip"
  clock settle
  tap "tab-tasks"
  tap "add-task"
  clock settle
  type "form-title" "Late"
  type "form-category" "1"
  type "form-due" "2026-03-10"
  tap "form-save"
  clock data
  clock settle
  tap "add-task"
  clock settle
  type "form-title" "Now"
  type "form-category" "2"
  type "form-due" "2026-03-15"
  tap "form-save"
  clock data
  clock settle
  tap "add-task"
  clock settle
  type "form-title" "Later"
  type "form-category" "2"
  type "form-due" "2026-03-30"
  tap "form-save"
  clock data
  clock settle
  tap "done-3"
  clock data
  tap "chip-overdue"
  expect state filter == "overdue"
  expect tree has "task-1"
  expect tree missing "task-2"
  expect tree missing "task-3"
  tap "chip-today"
  expect state filter == "today"
  expect tree has "task-2"
  expect tree missing "task-1"
  tap "chip-done"
  expect state filter == "done"
  expect tree has "task-3"
  expect tree missing "task-2"
  tap "chip-active"
  expect state filter == "active"
  expect tree has "task-1"
  expect tree missing "task-3"
  tap "chip-all"
  expect state filter == "all"
  type "filter-category" "2"
  expect tree missing "task-1"
  expect tree has "task-2"
  expect tree has "task-3"

test "a category is added with a count, a duplicate refused"
  clock +1600
  tap "onb-skip"
  clock settle
  tap "tab-tasks"
  tap "add-task"
  clock settle
  type "form-title" "Pay rent"
  type "form-category" "1"
  tap "form-save"
  clock data
  clock settle
  tap "tab-categories"
  expect text "count-1" == "1 task"
  expect text "count-2" == "0 tasks"
  tap "add-category"
  clock settle
  expect disabled "cat-save"
  type "cat-name" "Errands"
  tap "cat-save"
  clock data
  clock settle
  expect text "category-4" == "Errands"
  tap "add-category"
  clock settle
  type "cat-name" "errands"
  tap "cat-save"
  clock data
  expect text "cat-error" == "There is already a category called Errands."
  expect state categories.length == 4

test "the settings name greets on Home, and Home counts"
  epoch "2026-03-15T12:00:00Z"
  time-zone "UTC"
  clock +1600
  tap "onb-skip"
  clock settle
  clock data
  expect text "greeting" == "Hello"
  tap "tab-settings"
  type "settings-name" "Ada"
  tap "tab-tasks"
  tap "add-task"
  clock settle
  type "form-title" "Late"
  type "form-due" "2026-03-10"
  tap "form-save"
  clock data
  clock settle
  tap "add-task"
  clock settle
  type "form-title" "Now"
  type "form-due" "2026-03-15"
  tap "form-save"
  clock data
  clock settle
  tap "done-2"
  clock data
  tap "tab-home"
  expect text "greeting" == "Hello, Ada"
  expect text "progress-text" == "1 of 1 done today"
  expect text "count-all" == "2"
  expect text "count-today" == "1"
  expect text "count-overdue" == "1"
  expect tree has "upnext-1"
  expect tree missing "upnext-2"

// Home's Up next rows: swipe actions. Their buttons carry the row's testId and the action's name.
test "Home's Up next row completes a task through its swipe action"
  clock +1600
  tap "onb-skip"
  clock settle
  tap "tab-tasks"
  tap "add-task"
  clock settle
  type "form-title" "Call Ann"
  tap "form-save"
  clock data
  clock settle
  tap "tab-home"
  tap "upnext-1-complete"
  clock data
  expect state tasks.0 .done == true
  expect tree missing "upnext-1"

test "Home's Up next row opens the editor for its task through its swipe action"
  clock +1600
  tap "onb-skip"
  clock settle
  tap "tab-tasks"
  tap "add-task"
  clock settle
  type "form-title" "Call Ann"
  tap "form-save"
  clock data
  clock settle
  tap "add-task"
  clock settle
  type "form-title" "Buy milk"
  tap "form-save"
  clock data
  clock settle
  tap "tab-home"
  tap "upnext-2" wheel 152 0
  clock settle
  tap "upnext-2-edit"
  clock settle
  expect text "form-title" == "Buy milk"
  type "form-title" "Buy oat milk"
  tap "form-save"
  clock data
  clock settle
  expect state tasks.1 .title == "Buy oat milk"

test "Home's Up next row deletes a task through its swipe action, without asking"
  clock +1600
  tap "onb-skip"
  clock settle
  tap "tab-tasks"
  tap "add-task"
  clock settle
  type "form-title" "Call Ann"
  tap "form-save"
  clock data
  clock settle
  tap "tab-home"
  tap "upnext-1-delete"
  clock data
  expect state tasks == []
  expect tree missing "upnext-1"

test "scrolling an Up next row sideways reveals Complete on the right and Edit and Delete on the left"
  clock +1600
  tap "onb-skip"
  clock settle
  tap "tab-tasks"
  tap "add-task"
  clock settle
  type "form-title" "Call Ann"
  tap "form-save"
  clock data
  clock settle
  tap "add-task"
  clock settle
  type "form-title" "Buy milk"
  tap "form-save"
  clock data
  clock settle
  tap "tab-home"
  tap "upnext-1" wheel -76 0
  clock settle
  tap "upnext-1-complete"
  clock data
  expect state tasks.0 .done == true
  tap "upnext-2" wheel 152 0
  clock settle
  tap "upnext-2-delete"
  clock data
  expect tree missing "upnext-2"

test "tasks and the name survive a reload"
  clock +1600
  tap "onb-skip"
  clock settle
  tap "tab-settings"
  type "settings-name" "Ada"
  tap "tab-tasks"
  tap "add-task"
  clock settle
  type "form-title" "Keep me"
  tap "form-save"
  clock data
  clock settle
  reload
  clock +1600
  clock data
  expect state tasks.0 .title == "Keep me"
  expect state name == "Ada"

test "a category and a done task survive a reload"
  clock +1600
  tap "onb-skip"
  clock settle
  tap "tab-categories"
  tap "add-category"
  clock settle
  tap "swatch-orange"
  type "cat-name" "Errands"
  tap "cat-save"
  clock data
  clock settle
  tap "tab-tasks"
  tap "add-task"
  clock settle
  type "form-title" "Keep me"
  type "form-category" "4"
  tap "form-save"
  clock data
  clock settle
  tap "done-1"
  clock data
  reload
  clock +1600
  clock data
  expect state categories.3 .name == "Errands"
  expect state categories.3 .color == "orange"
  expect state tasks.0 .categoryId == "4"
  expect state tasks.0 .done == true

// Under the Contract runner nothing answers a device request: the position request waits
// on a permission ticket. A granted or denied permission and a preferred position are an
// agent drive's (app.test.mjs, `make test-location`).
test "the location card is idle until asked, then waits for the device"
  clock +1600
  tap "onb-skip"
  clock settle
  tap "tab-settings"
  expect enabled "location-button"
  expect tree missing "location-latitude"
  expect tree missing "location-message"
  tap "location-button"
  expect disabled "location-button"
  expect tree missing "location-message"

// Splash and onboarding. Every test starts from an empty store, as a fresh install does.
test "a fresh launch shows the splash, then the first onboarding step"
  expect tree has "splash"
  expect tree missing "onboarding"
  clock +1600
  expect tree missing "splash"
  expect tree has "onboarding"
  expect text "onb-title" == "Capture it all"
  expect text "onb-next" == "Next"

test "Next walks the four steps, the last offers Get started"
  clock +1600
  tap "onb-next"
  clock settle
  expect text "onb-title" == "Sort by category"
  tap "onb-next"
  clock settle
  expect text "onb-title" == "Never miss a time"
  tap "onb-next"
  clock settle
  expect text "onb-title" == "Watch progress grow"
  expect text "onb-next" == "Get started"
  tap "onb-back"
  clock settle
  expect text "onb-title" == "Never miss a time"

test "a dot jumps to its step"
  clock +1600
  tap "onb-dot-2"
  clock settle
  expect state step == 2
  expect text "onb-title" == "Never miss a time"

test "Skip lands on the tabs and the next launch skips onboarding"
  clock +1600
  tap "onb-skip"
  clock settle
  expect tree missing "onboarding"
  expect state onboarded == true
  reload
  expect tree has "splash"
  clock +1600
  expect tree missing "splash"
  expect tree missing "onboarding"

test "Get started on the last step marks onboarding done"
  clock +1600
  tap "onb-dot-3"
  clock settle
  tap "onb-next"
  clock settle
  expect tree missing "onboarding"
  expect state onboarded == true

test "reduced motion keeps the splash short and plain"
  prefer prefers-reduced-motion reduce
  clock +1000
  expect tree missing "splash"
  expect tree has "onboarding"

test "Settings shows the onboarding again, Skip returns to Settings"
  clock +1600
  tap "onb-skip"
  clock settle
  tap "tab-settings"
  tap "show-onboarding"
  clock settle
  expect tree has "onboarding"
  expect text "onb-title" == "Capture it all"
  tap "onb-skip"
  clock settle
  expect tree missing "onboarding"
  expect state onboarded == true
  expect text "settings-title" == "Settings"

test "the appearance choice is kept across a relaunch"
  clock +1600
  tap "onb-skip"
  clock settle
  tap "tab-settings"
  expect state scheme == "system"
  tap "scheme-dark"
  expect state scheme == "dark"
  reload
  clock +1600
  expect state scheme == "dark"
  tap "scheme-light"
  expect state scheme == "light"

test "swiping left and right changes the step"
  clock +1600
  tap "onb-content" drag -140 0 mouse
  clock settle
  expect state step == 1
  tap "onb-content" drag 140 0 mouse
  clock settle
  expect state step == 0

// Profile photo. The picker answers with fixtures/avatar.jpg (a 300x200 gradient).
test "the greeting is Hello, with the name when there is one"
  clock +1600
  tap "onb-skip"
  clock settle
  expect text "greeting" == "Hello"
  tap "tab-settings"
  type "settings-name" "Ada"
  tap "tab-home"
  expect text "greeting" == "Hello, Ada"

test "a picked photo shows in Settings and on Home, and survives a reload"
  clock +1600
  tap "onb-skip"
  clock settle
  tap "tab-settings"
  expect tree missing "avatar-photo"
  tap "avatar"
  pick "avatar-file" "fixtures/avatar.jpg"
  clock data
  clock settle
  expect tree has "avatar-photo"
  expect tree has "photo-remove"
  tap "tab-home"
  expect tree has "home-avatar-photo"
  reload
  clock +1600
  clock data
  expect tree has "home-avatar-photo"
  tap "tab-settings"
  expect tree has "avatar-photo"

test "Choose photo opens the same picker, and Cancel keeps the photo"
  clock +1600
  tap "onb-skip"
  clock settle
  tap "tab-settings"
  tap "photo-choose"
  pick "avatar-file" "fixtures/avatar.jpg"
  clock data
  clock settle
  expect tree has "avatar-photo"
  tap "photo-choose"
  pick "avatar-file" cancel
  clock settle
  expect tree has "avatar-photo"
  expect tree missing "photo-error"

test "cancelling the first picker leaves the fallback"
  clock +1600
  tap "onb-skip"
  clock settle
  tap "tab-settings"
  tap "avatar"
  pick "avatar-file" cancel
  clock settle
  expect tree missing "avatar-photo"
  expect tree missing "photo-remove"

test "Remove photo restores the initial on Settings and Home"
  clock +1600
  tap "onb-skip"
  clock settle
  tap "tab-settings"
  type "settings-name" "Ada"
  tap "avatar"
  pick "avatar-file" "fixtures/avatar.jpg"
  clock data
  clock settle
  tap "photo-remove"
  clock data
  clock settle
  expect tree missing "avatar-photo"
  expect tree missing "photo-remove"
  expect text "avatar-initial" == "A"
  tap "tab-home"
  expect tree missing "home-avatar-photo"
  expect text "home-avatar-initial" == "A"

test "the Market tab opens a chart whose zoom buttons stay within 20 to 200 candles"
  fail fetch "https://api.exchange.coinbase.com"
  clock +1600
  tap "onb-skip"
  clock settle
  tap "tab-market"
  clock settle
  expect tree has "market-chart"
  expect text "market-count" == "60 candles"
  tap "zoom-in"
  expect state count == 48
  tap "zoom-out"
  expect state count == 60
  tap "zoom-in"
  tap "zoom-in"
  tap "zoom-in"
  tap "zoom-in"
  tap "zoom-in"
  expect state count == 20
  tap "zoom-in"
  expect state count == 20
  tap "zoom-out"
  tap "zoom-out"
  tap "zoom-out"
  tap "zoom-out"
  tap "zoom-out"
  tap "zoom-out"
  tap "zoom-out"
  tap "zoom-out"
  tap "zoom-out"
  tap "zoom-out"
  tap "zoom-out"
  expect state count == 200
  expect text "market-count" == "200 candles"

test "double-tap resets the zoom and Latest follows the newest candle"
  fail fetch "https://api.exchange.coinbase.com"
  clock +1600
  tap "onb-skip"
  clock settle
  tap "tab-market"
  clock settle
  tap "zoom-out"
  expect state count == 75
  tap "market-chart" dblclick
  expect state count == 60
  tap "latest"
  expect state endT == 0

test "without history the Market tab says so and the status is not Live"
  fail fetch "https://api.exchange.coinbase.com"
  clock +1600
  tap "onb-skip"
  clock settle
  tap "tab-market"
  clock settle
  clock data
  expect state history.ok == false
  expect tree has "market-empty"
  expect text "market-price" == "--"

test "the socket is opened only while the Market tab shows"
  fail fetch "https://api.exchange.coinbase.com"
  clock +1600
  tap "onb-skip"
  clock settle
  clock data
  expect state live.status == "idle"
  expect tree has "tab-home"
